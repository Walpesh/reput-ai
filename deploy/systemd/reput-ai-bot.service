[Unit]
Description=ReputationAI Telegram Bot Service
After=network.target postgresql.service redis.service reput-ai-api.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/reput-ai
Environment="PATH=/opt/reput-ai/.venv/bin"
EnvironmentFile=/opt/reput-ai/.env
ExecStart=/opt/reput-ai/.venv/bin/python -m reput_ai.bot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
