[Unit]
Description=ReputationAI FastAPI Backend (fastapi)
Documentation=https://github.com/Walpesh/reput-ai
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/opt/reput-ai
Environment="PATH=/opt/reput-ai/.venv/bin"
EnvironmentFile=/opt/reput-ai/.env
ExecStart=/opt/reput-ai/.venv/bin/uvicorn reput_ai.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
