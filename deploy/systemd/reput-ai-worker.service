[Unit]
Description=ReputationAI Celery Worker & Beat Service
After=network.target redis.service postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/reput-ai
Environment="PATH=/opt/reput-ai/.venv/bin"
EnvironmentFile=/opt/reput-ai/.env
ExecStart=/opt/reput-ai/.venv/bin/celery -A reput_ai.workers.celery_app worker -B --loglevel=info --concurrency=4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
