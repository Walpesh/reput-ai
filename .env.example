# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-super-secret-key-at-least-32-chars-long
API_V1_STR=/api/v1
PROJECT_NAME="ReputationAI"

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reput_ai_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Telegram Bot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook

# OpenRouter / LLM
OPENROUTER_API_KEY=sk-or-v1-example-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PRIMARY_LLM_MODEL=deepseek/deepseek-chat
FALLBACK_LLM_MODEL=google/gemini-flash-1.5

# Billing (Yookassa / T-Bank)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_WEBHOOK_SECRET=your_webhook_secret

# External Platforms Scraper / Polling
SCRAPER_POLL_INTERVAL_MINUTES=15
