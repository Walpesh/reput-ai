# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-super-secret-key-at-least-32-chars-long
API_V1_STR=/api/v1
PROJECT_NAME="ReputationAI"

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reput_ai_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Telegram Bot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook

# OpenRouter / LLM
OPENROUTER_API_KEY=sk-or-v1-example-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PRIMARY_LLM_MODEL=deepseek/deepseek-chat
FALLBACK_LLM_MODEL=google/gemini-flash-1.5

# Billing (Yookassa / T-Bank)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_WEBHOOK_SECRET=your_webhook_secret
YOOKASSA_API_URL=https://api.yookassa.ru/v3
TBANK_PASSWORD=your_tbank_terminal_password
TRIAL_PERIOD_DAYS=14
BILLING_PERIOD_DAYS=30
BILLING_GRACE_PERIOD_DAYS=3
BILLING_PRICE_RUB=2990
BILLING_CURRENCY=RUB
BILLING_RENEWAL_LEAD_HOURS=24
BILLING_RETURN_URL=https://your-domain.com/billing/success

# Public funnel (QR codes / short links)
PUBLIC_BASE_URL=https://your-domain.com
FEEDBACK_FORM_PATH=/feedback/form

# External Platforms Scraper / Polling (поддерживаемое окно опроса 15-30 минут)
SCRAPER_POLL_INTERVAL_MINUTES=15
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_ATTEMPTS=3
SCRAPER_MAX_REVIEWS_PER_BRANCH=50
SCRAPER_USER_AGENT=ReputationAI/0.1 (+https://your-domain.com)

# AI processing of freshly collected reviews
AI_PROCESSING_INTERVAL_MINUTES=5
AI_BATCH_SIZE=10
